# Shared network of the eole.me ecosystem. Locally, leave EXTERNAL at false:
# compose then creates its own isolated bridge.
DOCKER_NETWORK_NAME=eole_shared_network
DOCKER_NETWORK_EXTERNAL=false

# Vector, which relays to Axiom. Empty locally = nothing sent, events stay
# visible on the container's standard output.
TELEMETRY_WEBHOOK_URL=

# Extractions per day past which the service emits a "usage_threshold_crossed"
# event, to decide whether limits are needed.
SC2BO_FEEDBACK_THRESHOLD=50

# 12 MB. A replay rarely goes past 3 MB.
SC2BO_MAX_UPLOAD_BYTES=12582912
