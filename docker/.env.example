# Réseau partagé de l'écosystème eole.me. En local, laissez EXTERNAL à false :
# le compose crée alors son propre bridge isolé.
DOCKER_NETWORK_NAME=eole_shared_network
DOCKER_NETWORK_EXTERNAL=false

# Vector, qui relaie vers Axiom. Vide en local = pas de télémétrie envoyée,
# les événements restent visibles sur la sortie standard du conteneur.
TELEMETRY_WEBHOOK_URL=

# Nombre d'extractions par jour au-delà duquel le service émet un événement
# « usage_threshold_crossed », pour décider s'il faut ajouter des limites.
SC2BO_FEEDBACK_THRESHOLD=50

# 12 Mo. Un replay dépasse rarement 3 Mo.
SC2BO_MAX_UPLOAD_BYTES=12582912
